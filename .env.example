SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

JWT_SECRET=MiniFormigaDevSecretKeyForJwtHs256WithAtLeast32Bytes
JWT_EXPIRATION_MINUTES=480
SYNC_TOKEN=MiniFormigaSyncDevToken
DEMO_DATA_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://0.0.0.0:3000,http://localhost:13000,http://127.0.0.1:13000

# Backend local (loja)
DB_URL=jdbc:sqlite:./mini-formiga-local.db
CENTRAL_SYNC_URL=http://localhost:8081/api/v1/central/sincronizacao/receber

# Backend central (servidor central)
# Ao arrancar o perfil central manualmente, substituir DB_URL por:
# DB_URL=jdbc:postgresql://localhost:5433/miniFormiga_central
DB_USERNAME=miniFormiga
DB_PASSWORD=miniFormiga_dev

# Frontend
VITE_API_BASE_URL=http://localhost:8080/api/v1
